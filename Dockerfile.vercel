FROM php:8.3-apache-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-venv libpq-dev \
    && docker-php-ext-install pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html
COPY . .

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r api/requirements.txt \
    && chmod +x api/export_excel.py \
    && a2enmod rewrite cgi \
    && printf '%s\n' \
        'ScriptAlias /QLNCKH/api/export-excel /var/www/html/api/export_excel.py' \
        'SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1' \
        'PassEnv DATABASE_URL JWT_SECRET BLOB_READ_WRITE_TOKEN ABLY_API_KEY' \
        'Alias /QLNCKH/ /var/www/html/' \
        '<Directory /var/www/html>' \
        '    Options FollowSymLinks ExecCGI' \
        '    AllowOverride All' \
        '    Require all granted' \
        '</Directory>' \
        '<Directory /var/www/html/api>' \
        '    Options +ExecCGI' \
        '    AddHandler cgi-script .py' \
        '</Directory>' \
        > /etc/apache2/conf-available/qlnckh.conf \
    && a2enconf qlnckh

ENV PATH="/opt/venv/bin:${PATH}"
EXPOSE 80
